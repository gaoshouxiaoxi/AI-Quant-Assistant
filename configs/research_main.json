{
  "protocol_version": "1.0.0",
  "description": "AI-Quant-Assistant 可复现研究协议：日度 RV 的 HAR 预测（严格样本外）",
  "seed": 42,

  "universe": [
    {"ticker": "600519", "name": "贵州茅台", "bars": "data/minute/sh600519_60m.csv"},
    {"ticker": "000858", "name": "五粮液",   "bars": "data/minute/sz000858_60m.csv"},
    {"ticker": "000001", "name": "平安银行", "bars": "data/minute/sz000001_60m.csv"}
  ],

  "data": {
    "source": "committed_60m_bars",
    "bar_minutes": 60,
    "trading_days_per_year": 252,
    "rv_definition": "sum(r_i^2) + overnight^2, 日度方差，未年化",
    "min_bars_per_day": 2,
    "network_required": false
  },

  "target": {
    "name": "future_mean_rv",
    "horizon_days": 5,
    "space": "log",
    "formula": "log(mean(RV[t+1 : t+5]))"
  },

  "split": {
    "scheme": "expanding_walk_forward",
    "n_splits": 5,
    "min_train_frac": 0.4,
    "purge_rows": 5,
    "purge_reason": "标签前视窗口 = 5 日，训练集末尾必须剔除 5 行"
  },

  "missing": {
    "rule": "drop_rows_with_nan_in_target_or_any_feature",
    "sample_alignment": "common_index_over_all_features_and_baselines"
  },

  "models": [
    {"name": "HAR-3", "features": ["rv_d", "rv_w", "rv_m"], "estimator": "ols"},
    {"name": "HAR-3+kurt22", "features": ["rv_d", "rv_w", "rv_m", "kurt22"], "estimator": "ols"},
    {"name": "HAR-X(多因子)", "features": ["rv_d", "rv_w", "rv_m", "vol_ratio", "overnight_share", "range_ratio", "skew22", "kurt22", "vol_asym", "absret"], "estimator": "ols"},
    {"name": "RandomForest", "features": ["rv_d", "rv_w", "rv_m", "vol_ratio", "overnight_share", "range_ratio", "skew22", "kurt22", "vol_asym", "absret"], "estimator": "random_forest"}
  ],

  "baselines": [
    {"name": "持续性(周均 RV)", "feature": "rv_w"},
    {"name": "持续性(当日 RV)", "feature": "rv_d"}
  ],

  "metrics": ["n", "r2", "mae", "skill", "spearman", "spearman_base", "disp_ratio", "calib_slope"],

  "sklearn_params": {
    "random_forest": {"n_estimators": 300, "max_depth": 4, "min_samples_leaf": 15, "n_jobs": 1}
  },

  "outputs": {
    "results_csv": "reports/research/results_main.csv",
    "manifest": "reports/research/manifest.json",
    "chart_dir": "charts/research"
  }
}
